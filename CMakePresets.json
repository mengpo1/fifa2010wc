{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "linux-amd64-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-march=x86-64-v2"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-amd64-debug",
      "displayName": "Linux x86_64 Debug",
      "inherits": "linux-amd64-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-amd64-release",
      "displayName": "Linux x86_64 Release",
      "inherits": "linux-amd64-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-amd64-relwithdebinfo",
      "displayName": "Linux x86_64 RelWithDebInfo",
      "inherits": "linux-amd64-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    }
  ],
  "buildPresets": [
    { "name": "linux-amd64-debug", "configurePreset": "linux-amd64-debug" },
    { "name": "linux-amd64-release", "configurePreset": "linux-amd64-release" },
    { "name": "linux-amd64-relwithdebinfo", "configurePreset": "linux-amd64-relwithdebinfo" }
  ]
}
