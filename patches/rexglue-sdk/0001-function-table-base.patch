   CHECK(dispatcher.GetFunction(kImageBase + 0x10) == nullptr);
 }
 
+// fifa2010wc patch: the dispatch table of a module can be placed with table_base, so that the
+// default table, which follows the image, does not run into the image of the next module.
+REX_TEST_CASE("InitializeFunctionTable places the table at table_base", "[kernel][dispatcher]") {
+  auto& memory = GetTestMemory();
+  rex::kernel::FunctionDispatcher dispatcher(&memory);
+
+  constexpr u32 kImageBase = 0x8D000000u;
+  constexpr u32 kCodeSize = 0x10000u;
+  constexpr u32 kImageSize = 0x100000u;
+  constexpr u32 kTableBase = 0x8DC00000u;
+
+  REQUIRE(dispatcher.InitializeFunctionTable(kImageBase, kCodeSize, kImageBase, kImageSize,
+                                             /*is_entrypoint=*/false, kTableBase));
+  REQUIRE(dispatcher.SetFunction(kImageBase + 0x10, &DummyFn));
+  CHECK(*memory.TranslateVirtual<PPCFunc**>(kTableBase + 0x10 * 2) == &DummyFn);
+  CHECK(dispatcher.GetFunction(kImageBase + 0x10) == &DummyFn);
+}
+
+REX_TEST_CASE("A default table that runs into the next image is refused", "[kernel][dispatcher]") {
+  auto& memory = GetTestMemory();
+  rex::kernel::FunctionDispatcher dispatcher(&memory);
+
+  // The table of A takes (0x80000 + 0x10000) * 2 = 0x120000 bytes after its image, up to
+  // 0x8D410000, past the image of B at 0x8D400000.
+  constexpr u32 kImageA = 0x8D100000u;
+  constexpr u32 kImageB = 0x8D400000u;
+  REQUIRE(dispatcher.InitializeFunctionTable(kImageA, 0x80000u, kImageA, 0x1F0000u));
+  CHECK_FALSE(dispatcher.InitializeFunctionTable(kImageB, 0x10000u, kImageB, 0x100000u));
+}
+
+REX_TEST_CASE("A table moved with table_base lets the next image load", "[kernel][dispatcher]") {
+  auto& memory = GetTestMemory();
+  rex::kernel::FunctionDispatcher dispatcher(&memory);
+
+  constexpr u32 kImageA = 0x8D500000u;
+  constexpr u32 kImageB = 0x8D700000u;
+  REQUIRE(dispatcher.InitializeFunctionTable(kImageA, 0x80000u, kImageA, 0x1F0000u,
+                                             /*is_entrypoint=*/false, 0x8DD00000u));
+  REQUIRE(dispatcher.InitializeFunctionTable(kImageB, 0x10000u, kImageB, 0x100000u));
+  REQUIRE(dispatcher.SetFunction(kImageA + 0x20, &DummyFn));
+  CHECK(*memory.TranslateVirtual<PPCFunc**>(0x8DD00000u + 0x20 * 2) == &DummyFn);
+}
+
+REX_TEST_CASE("A table that overlaps another table or its own image is refused",
+              "[kernel][dispatcher]") {
+  auto& memory = GetTestMemory();
+  rex::kernel::FunctionDispatcher dispatcher(&memory);
+
+  // A's table takes (0x10000 + 0x10000) * 2 = 0x40000 bytes from 0x8DF00000.
+  constexpr u32 kImageA = 0x8D900000u;
+  REQUIRE(dispatcher.InitializeFunctionTable(kImageA, 0x10000u, kImageA, 0x100000u,
+                                             /*is_entrypoint=*/false, 0x8DF00000u));
+  constexpr u32 kImageB = 0x8DA00000u;
+  CHECK_FALSE(dispatcher.InitializeFunctionTable(kImageB, 0x10000u, kImageB, 0x100000u,
+                                                 /*is_entrypoint=*/false, 0x8DF20000u));
+  constexpr u32 kImageC = 0x8DB00000u;
+  CHECK_FALSE(dispatcher.InitializeFunctionTable(kImageC, 0x10000u, kImageC, 0x100000u,
+                                                 /*is_entrypoint=*/false, 0x8DB80000u));
+}
+
+// AllocFixed with reserve and commit takes over pages that are already reserved, so a moved
+// table must be refused there rather than wipe them.
+REX_TEST_CASE("A moved table is refused on pages that are already reserved",
+              "[kernel][dispatcher]") {
+  auto& memory = GetTestMemory();
+  rex::kernel::FunctionDispatcher dispatcher(&memory);
+
+  // A page held by something else in the 0x80000000 heap, such as an XEX image.
+  constexpr u32 kOccupied = 0x8E000000u;
+  auto* heap = memory.LookupHeap(kOccupied);
+  REQUIRE(heap != nullptr);
+  REQUIRE(heap->AllocFixed(
+      kOccupied, 0x10000u, 0x10000u,
+      rex::kernel::kMemoryAllocationReserve | rex::kernel::kMemoryAllocationCommit,
+      rex::kernel::kMemoryProtectRead | rex::kernel::kMemoryProtectWrite));
+  *memory.TranslateVirtual<u32*>(kOccupied + 0x100) = 0x12345678u;
+
+  // The table would take (0x10000 + 0x10000) * 2 = 0x40000 bytes from 0x8DFF0000, over the
+  // occupied page. No module overlaps it, so only the guest memory check can refuse it.
+  constexpr u32 kImageA = 0x8E100000u;
+  CHECK_FALSE(dispatcher.InitializeFunctionTable(kImageA, 0x10000u, kImageA, 0x100000u,
+                                                 /*is_entrypoint=*/false, 0x8DFF0000u));
+  CHECK(*memory.TranslateVirtual<u32*>(kOccupied + 0x100) == 0x12345678u);
+
+  // The same module is accepted with its table on free pages.
+  CHECK(dispatcher.InitializeFunctionTable(kImageA, 0x10000u, kImageA, 0x100000u,
+                                           /*is_entrypoint=*/false, 0x8E400000u));
+}
+
+namespace {
+constexpr u32 kTableAllocation =
+    rex::kernel::kMemoryAllocationReserve | rex::kernel::kMemoryAllocationCommit;
+constexpr u32 kTableProtect = rex::kernel::kMemoryProtectRead | rex::kernel::kMemoryProtectWrite;
+
+// Clears the test hook of the shared test memory when a test ends, even on a failed REQUIRE.
+struct TableHookReset {
+  rex::kernel::GuestAddressSpace& memory;
+  ~TableHookReset() { memory.function_table_alloc_hook_for_testing = nullptr; }
+};
+}  // namespace
+
+// The free page check and the allocation must be one step. The hook runs at the last moment
+// before the allocation, after the range is worked out; there another thread reserves a page of
+// the range, and is joined so that the order is fixed. A separate check made before the hook
+// would have missed that page, and the table would have taken it over and wiped it.
+REX_TEST_CASE("A page reserved by another thread just before a moved table is allocated is kept",
+              "[kernel][dispatcher]") {
+  auto& memory = GetTestMemory();
+  rex::kernel::FunctionDispatcher dispatcher(&memory);
+  TableHookReset reset{memory};
+
+  // The table takes (0x10000 + 0x10000) * 2 = 0x40000 bytes from 0x8E600000.
+  constexpr u32 kImage = 0x8E300000u;
+  constexpr u32 kTableBase = 0x8E600000u;
+  constexpr u32 kRacer = kTableBase + 0x20000u;
+  auto* heap = memory.LookupHeap(kRacer);
+  REQUIRE(heap != nullptr);
+
+  bool hook_ran = false;
+  bool racer_allocated = false;
+  memory.function_table_alloc_hook_for_testing = [&](u32 table_base, u32 table_size) {
+    hook_ran = table_base == kTableBase && table_size == 0x40000u;
+    std::thread racer([&] {
+      racer_allocated = heap->AllocFixed(kRacer, 0x10000u, 0x10000u, kTableAllocation,
+                                         kTableProtect);
+      if (racer_allocated) {
+        *memory.TranslateVirtual<u32*>(kRacer + 0x100) = 0x12345678u;
+      }
+    });
+    racer.join();
+  };
+
+  CHECK_FALSE(dispatcher.InitializeFunctionTable(kImage, 0x10000u, kImage, 0x100000u,
+                                                 /*is_entrypoint=*/false, kTableBase));
+  CHECK(hook_ran);
+  REQUIRE(racer_allocated);
+  // The page of the other thread keeps its owner and its content.
+  CHECK(*memory.TranslateVirtual<u32*>(kRacer + 0x100) == 0x12345678u);
+  rex::kernel::HeapAllocation info{};
+  REQUIRE(heap->QueryRegionInfo(kRacer, &info));
+  CHECK(info.allocation_base == kRacer);
+  // Nothing of the table range was taken.
+  REQUIRE(heap->QueryRegionInfo(kTableBase, &info));
+  CHECK(info.state == 0);
+  CHECK(info.region_size == 0x20000u);
+}
+
+REX_TEST_CASE("An exclusive fixed allocation takes no page when one page is reserved",
+              "[kernel][dispatcher]") {
+  auto& memory = GetTestMemory();
+  constexpr u32 kBase = 0x8E800000u;
+  auto* heap = memory.LookupHeap(kBase);
+  REQUIRE(heap != nullptr);
+
+  // The last page of the range is reserved.
+  REQUIRE(heap->AllocFixed(kBase + 0x30000u, 0x10000u, 0x10000u, kTableAllocation,
+                           kTableProtect));
+  *memory.TranslateVirtual<u32*>(kBase + 0x30000u) = 0xCAFEF00Du;
+  CHECK_FALSE(heap->AllocFixedExclusive(kBase, 0x40000u, 0x10000u, kTableAllocation,
+                                        kTableProtect));
+
+  // The three free pages stay free, and the reserved page keeps its owner and content.
+  rex::kernel::HeapAllocation info{};
+  REQUIRE(heap->QueryRegionInfo(kBase, &info));
+  CHECK(info.state == 0);
+  CHECK(info.region_size == 0x30000u);
+  REQUIRE(heap->QueryRegionInfo(kBase + 0x30000u, &info));
+  CHECK(info.allocation_base == kBase + 0x30000u);
+  CHECK(*memory.TranslateVirtual<u32*>(kBase + 0x30000u) == 0xCAFEF00Du);
+
+  // Free pages are taken.
+  CHECK(heap->AllocFixedExclusive(kBase, 0x30000u, 0x10000u, kTableAllocation, kTableProtect));
+  REQUIRE(heap->QueryRegionInfo(kBase, &info));
+  CHECK(info.allocation_base == kBase);
+}
+
+REX_TEST_CASE("A moved table is released when it is destroyed", "[kernel][dispatcher]") {
+  auto& memory = GetTestMemory();
+  constexpr u32 kCode = 0x8E900000u;
+  constexpr u32 kTableBase = 0x8EA00000u;
+  auto* heap = memory.LookupHeap(kTableBase);
+  REQUIRE(heap != nullptr);
+
+  REQUIRE(memory.InitializeFunctionTable(kCode, 0x10000u, kCode, 0x10000u, kTableBase));
+  rex::kernel::HeapAllocation info{};
+  REQUIRE(heap->QueryRegionInfo(kTableBase, &info));
+  CHECK(info.allocation_base == kTableBase);
+
+  REQUIRE(memory.DestroyFunctionTable(kCode));
+  REQUIRE(heap->QueryRegionInfo(kTableBase, &info));
+  CHECK(info.state == 0);
+}
+
+// Sizes and ends are computed in 64 bits. In 32 bits, (0x80000000 + 0x10000) * 2 wraps to
+// 0x20000, and a table of that size would have been allocated for a code range far larger.
+REX_TEST_CASE("A table or code range that does not fit is refused", "[kernel][dispatcher]") {
+  auto& memory = GetTestMemory();
+  rex::kernel::FunctionDispatcher dispatcher(&memory);
+  constexpr u32 kTableBase = 0x8EC00000u;
+  auto* heap = memory.LookupHeap(kTableBase);
+  REQUIRE(heap != nullptr);
+
+  // Table size past 4 GiB, given straight to the guest memory and through the dispatcher.
+  CHECK_FALSE(memory.InitializeFunctionTable(0x10000000u, 0x80000000u, 0x10000000u, 0x10000u,
+                                             kTableBase));
+  CHECK_FALSE(dispatcher.InitializeFunctionTable(0x10000000u, 0x80000000u, 0x8EB00000u, 0x10000u,
+                                                 /*is_entrypoint=*/false, kTableBase));
+  rex::kernel::HeapAllocation info{};
+  REQUIRE(heap->QueryRegionInfo(kTableBase, &info));
+  CHECK(info.state == 0);
+
+  // Table end past the end of the 0x80000000 heap: (0x80000 + 0x10000) * 2 = 0x120000 bytes
+  // from 0x8FF00000 end at 0x90020000.
+  CHECK_FALSE(memory.InitializeFunctionTable(0x8FE00000u, 0x80000u, 0x8FE00000u, 0x10000u,
+                                             0x8FF00000u));
+
+  // Code range, with its thunk reserve, past 4 GiB.
+  CHECK_FALSE(dispatcher.InitializeFunctionTable(0xFFFF0000u, 0x8000u, 0x8EB00000u, 0x10000u,
+                                                 /*is_entrypoint=*/false, kTableBase));
+  // The same module with a code range that fits is accepted.
+  CHECK(dispatcher.InitializeFunctionTable(0x8EB00000u, 0x8000u, 0x8EB00000u, 0x10000u,
+                                           /*is_entrypoint=*/false, kTableBase));
+}
