+/**
+ * @file        tests/unit/codegen/function_table_base_test.cpp
+ * @brief       The function_table_base key places the dispatch table (fifa2010wc patch)
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include "code_image.h"
+#include "rex_test.h"
+#include "temp_folder.h"
+
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace {
+
+using rex::u32;
+
+constexpr u32 kBlr = 0x4E800020;
+
+struct Generated {
+  bool ok = false;
+  std::string tree;
+};
+
+// One function, `blr`, in a synthetic image; no game data.
+Generated Generate(std::string_view extra_manifest) {
+  const std::vector<u32> words = {kBlr};
+  const rex::test::PDataEntry pdata[] = {
+      {rex::test::kCodeImageBase + rex::test::kCodeImageCodeOffset, 1}};
+  rex::test::TempFolder folder;
+  const auto result = rex::test::GenerateFromImage(
+      folder, rex::test::BuildCodeImage(words, pdata), extra_manifest, /*force=*/false);
+  Generated out;
+  out.ok = static_cast<bool>(result);
+  if (out.ok) {
+    out.tree = rex::test::ReadGeneratedTree(folder.path / "generated" / "entry");
+  }
+  return out;
+}
+
+}  // namespace
+
+REX_TEST_CASE("Without function_table_base the table follows the image",
+              "[codegen][function_table_base]") {
+  const auto generated = Generate("");
+  REQUIRE(generated.ok);
+  // kCodeImageBase + kCodeImageSize
+  CHECK(generated.tree.find("#define REX_FUNC_TABLE_BASE 0x82010000ull") != std::string::npos);
+  CHECK(generated.tree.find(".function_table_base = REX_FUNC_TABLE_BASE,") != std::string::npos);
+  CHECK(generated.tree.find("x + REX_FUNC_TABLE_BASE +") != std::string::npos);
+  CHECK(generated.tree.find("REX_IMAGE_BASE + REX_IMAGE_SIZE +") == std::string::npos);
+}
+
+REX_TEST_CASE("function_table_base moves the table", "[codegen][function_table_base]") {
+  const auto generated = Generate("function_table_base = 0x8C000000\n");
+  REQUIRE(generated.ok);
+  CHECK(generated.tree.find("#define REX_FUNC_TABLE_BASE 0x8C000000ull") != std::string::npos);
+  CHECK(generated.tree.find(".function_table_base = REX_FUNC_TABLE_BASE,") != std::string::npos);
+}
+
+REX_TEST_CASE("A function_table_base that is not 64 KiB aligned is refused",
+              "[codegen][function_table_base]") {
+  CHECK_FALSE(Generate("function_table_base = 0x8C000100\n").ok);
+}
+
+REX_TEST_CASE("A function_table_base outside the 0x80000000 heap is refused",
+              "[codegen][function_table_base]") {
+  CHECK_FALSE(Generate("function_table_base = 0x70000000\n").ok);
+  CHECK_FALSE(Generate("function_table_base = 0x90000000\n").ok);
+  CHECK_FALSE(Generate("function_table_base = 0x100000000\n").ok);
+}
