+// fifa2010wc patch: the dispatch table of a module can be placed with table_base, so that the
+// default table, which follows the image, does not run into the image of the next module.
+REX_TEST_CASE("InitializeFunctionTable places the table at table_base", "[kernel][dispatcher]") {
+  auto& memory = GetTestMemory();
+  rex::kernel::FunctionDispatcher dispatcher(&memory);
+
+  constexpr u32 kImageBase = 0x8D000000u;
+  constexpr u32 kCodeSize = 0x10000u;
+  constexpr u32 kImageSize = 0x100000u;
+  constexpr u32 kTableBase = 0x8DC00000u;
+
+  REQUIRE(dispatcher.InitializeFunctionTable(kImageBase, kCodeSize, kImageBase, kImageSize,
+                                             /*is_entrypoint=*/false, kTableBase));
+  REQUIRE(dispatcher.SetFunction(kImageBase + 0x10, &DummyFn));
+  CHECK(*memory.TranslateVirtual<PPCFunc**>(kTableBase + 0x10 * 2) == &DummyFn);
+  CHECK(dispatcher.GetFunction(kImageBase + 0x10) == &DummyFn);
+}
+
+REX_TEST_CASE("A default table that runs into the next image is refused", "[kernel][dispatcher]") {
+  auto& memory = GetTestMemory();
+  rex::kernel::FunctionDispatcher dispatcher(&memory);
+
+  // The table of A takes (0x80000 + 0x10000) * 2 = 0x120000 bytes after its image, up to
+  // 0x8D410000, past the image of B at 0x8D400000.
+  constexpr u32 kImageA = 0x8D100000u;
+  constexpr u32 kImageB = 0x8D400000u;
+  REQUIRE(dispatcher.InitializeFunctionTable(kImageA, 0x80000u, kImageA, 0x1F0000u));
+  CHECK_FALSE(dispatcher.InitializeFunctionTable(kImageB, 0x10000u, kImageB, 0x100000u));
+}
+
+REX_TEST_CASE("A table moved with table_base lets the next image load", "[kernel][dispatcher]") {
+  auto& memory = GetTestMemory();
+  rex::kernel::FunctionDispatcher dispatcher(&memory);
+
+  constexpr u32 kImageA = 0x8D500000u;
+  constexpr u32 kImageB = 0x8D700000u;
+  REQUIRE(dispatcher.InitializeFunctionTable(kImageA, 0x80000u, kImageA, 0x1F0000u,
+                                             /*is_entrypoint=*/false, 0x8DD00000u));
+  REQUIRE(dispatcher.InitializeFunctionTable(kImageB, 0x10000u, kImageB, 0x100000u));
+  REQUIRE(dispatcher.SetFunction(kImageA + 0x20, &DummyFn));
+  CHECK(*memory.TranslateVirtual<PPCFunc**>(0x8DD00000u + 0x20 * 2) == &DummyFn);
+}
+
+REX_TEST_CASE("A table that overlaps another table or its own image is refused",
+              "[kernel][dispatcher]") {
+  auto& memory = GetTestMemory();
+  rex::kernel::FunctionDispatcher dispatcher(&memory);
+
+  // A's table takes (0x10000 + 0x10000) * 2 = 0x40000 bytes from 0x8DF00000.
+  constexpr u32 kImageA = 0x8D900000u;
+  REQUIRE(dispatcher.InitializeFunctionTable(kImageA, 0x10000u, kImageA, 0x100000u,
+                                             /*is_entrypoint=*/false, 0x8DF00000u));
+  constexpr u32 kImageB = 0x8DA00000u;
+  CHECK_FALSE(dispatcher.InitializeFunctionTable(kImageB, 0x10000u, kImageB, 0x100000u,
+                                                 /*is_entrypoint=*/false, 0x8DF20000u));
+  constexpr u32 kImageC = 0x8DB00000u;
+  CHECK_FALSE(dispatcher.InitializeFunctionTable(kImageC, 0x10000u, kImageC, 0x100000u,
+                                                 /*is_entrypoint=*/false, 0x8DB80000u));
+}
+
+// AllocFixed with reserve and commit takes over pages that are already reserved, so a moved
+// table must be refused there rather than wipe them.
+REX_TEST_CASE("A moved table is refused on pages that are already reserved",
+              "[kernel][dispatcher]") {
+  auto& memory = GetTestMemory();
+  rex::kernel::FunctionDispatcher dispatcher(&memory);
+
+  // A page held by something else in the 0x80000000 heap, such as an XEX image.
+  constexpr u32 kOccupied = 0x8E000000u;
+  auto* heap = memory.LookupHeap(kOccupied);
+  REQUIRE(heap != nullptr);
+  REQUIRE(heap->AllocFixed(
+      kOccupied, 0x10000u, 0x10000u,
+      rex::kernel::kMemoryAllocationReserve | rex::kernel::kMemoryAllocationCommit,
+      rex::kernel::kMemoryProtectRead | rex::kernel::kMemoryProtectWrite));
+  *memory.TranslateVirtual<u32*>(kOccupied + 0x100) = 0x12345678u;
+
+  // The table would take (0x10000 + 0x10000) * 2 = 0x40000 bytes from 0x8DFF0000, over the
+  // occupied page. No module overlaps it, so only the guest memory check can refuse it.
+  constexpr u32 kImageA = 0x8E100000u;
+  CHECK_FALSE(dispatcher.InitializeFunctionTable(kImageA, 0x10000u, kImageA, 0x100000u,
+                                                 /*is_entrypoint=*/false, 0x8DFF0000u));
+  CHECK(*memory.TranslateVirtual<u32*>(kOccupied + 0x100) == 0x12345678u);
+
+  // The same module is accepted with its table on free pages.
+  CHECK(dispatcher.InitializeFunctionTable(kImageA, 0x10000u, kImageA, 0x100000u,
+                                           /*is_entrypoint=*/false, 0x8E400000u));
+}
